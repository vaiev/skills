# KEY=VALUE data; quote values containing spaces. Environment overrides this file.
# Use absolute local paths. Keep this file outside PERSIST_INCLUDE.
PERSIST_STORE="/path/to/private-store"
PERSIST_INCLUDE="/path/to/project /path/to/other-data"
# For a path containing spaces, use nested quotes:
# PERSIST_INCLUDE="'/path/with spaces' /path/to/other-data"
# Optional: make a consistent SQLite backup instead of copying the live DB.
HUB_DB=""
# Required only for remote operations. Provision known_hosts independently.
PERSIST_HOST=""
PERSIST_USER=""
PERSIST_KEY="/path/to/private-key"
PERSIST_PORT="22"
PERSIST_KNOWN_HOSTS="/path/to/known_hosts"
PERSIST_REMOTE_DIR="backups"
PERSIST_PY="python3"
